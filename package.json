{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "description": "Anonymous insider reports, with a response clock anyone can verify. Built on Midnight.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "compact compile contract/sotto.compact contract/managed/sotto",
    "compile:fast": "compact compile --skip-zk contract/sotto.compact contract/managed/sotto",
    "typecheck": "tsc --noEmit -p .",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run --exclude 'src/**/*.sim.test.ts'",
    "test:local": "MIDNIGHT_NETWORK=local npm test --",
    "test:preview": "MIDNIGHT_NETWORK=preview npm test --",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.5",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2",
    "@midnight-ntwrk/dapp-connector-api": "4.1.0",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "buffer": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "6.4.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.1.2",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "overrides": {
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnightntwrk/zkir-v3": "3.2.0"
  }
}
